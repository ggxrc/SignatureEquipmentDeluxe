	IndividualItemOverride: {
		Tooltip: ""
		TargetHeader: 🎯 Target Item
		StatsHeader: 📊 Custom Stat Configuration

		TargetItem: {
			Label: Target Item
			Tooltip:
				'''
				Select the item that will use custom scaling settings.
				This override will ignore global ScalingConfig settings.
				'''
		}

		CustomDamage: {
			Label: Custom Damage Scaling
			Tooltip:
				'''
				Configure custom damage scaling for this item.
				Supports both Fixed and Tiered modes independently.
				'''
		}

		CustomCritChance: {
			Label: Custom Critical Chance Scaling
			Tooltip:
				'''
				Configure custom critical strike chance scaling for this item.
				Supports both Fixed and Tiered modes independently.
				'''
		}

		CustomUseTime: {
			Label: Custom Use Time Scaling
			Tooltip:
				'''
				Configure custom use time reduction for this item.
				Lower use time = faster attacks.
				'''
		}

		CustomUseAnimation: {
			Label: Custom Animation Speed Scaling
			Tooltip:
				'''
				Configure custom animation speed for this item.
				Faster animations = smoother combat.
				'''
		}

		CustomMeleeSize: {
			Label: Custom Melee Size Scaling
			Tooltip:
				'''
				Configure custom melee weapon size scaling.
				Larger size = bigger hitbox and reach.
				'''
		}

		CustomManaCostReduction: {
			Label: Custom Mana Cost Reduction
			Tooltip:
				'''
				Configure custom mana cost reduction for magic weapons.
				Higher reduction = cheaper spells.
				'''
		}

		CustomAmmoConsumptionReduction: {
			Label: Custom Ammo Conservation
			Tooltip:
				'''
				Configure custom ammo conservation for ranged weapons.
				Higher chance = less ammo consumed.
				'''
		}

		StatusIncreaseType: {
			Label: Status Increase Type
			Tooltip: Choose how this item's stats increase: Raw (fixed per level) or Percentage (based on original stats). Overrides the global setting.
		}
	}

	StatusIncreaseType: {
		Tooltip: ""

		Raw: {
			Label: Raw Status
			Tooltip: Stats increase by fixed values per level (original system)
		}

		Percentage: {
			Label: Equipment Status Percentage
			Tooltip:
				'''
				Stats increase based on a percentage of the item's ORIGINAL stats.
				Example: If a weapon has 50 base damage and PercentagePerLevel = 15,
				each level adds +7.5 damage (15% of 50).
				'''
		}
	}

