WorldConfig: {
	DisplayName: World Configuration

	EnableLeveledEnemies: {
		Label: Enable Leveled Enemies
		Tooltip: Activates the leveled enemy system. Enemies can spawn with levels based on world progression. Requires mod reload. Default: true
	}

	LeveledEnemySpawnChance: {
		Label: Leveled Enemy Spawn Chance (in %)
		Tooltip: Percentage chance for enemies to spawn with a level. Range: 1-100%. Default: 15%
	}

	WorldLevelMode: {
		Tooltip: ""

		BossProgression: {
			Label: Boss Progression
			Tooltip: ""
		}

		TimeProgression: {
			Label: Time Progression
			Tooltip: ""
		}

		Disabled: {
			Label: Disabled
			Tooltip: ""
		}
	}

	PreHardmodeMaxLevel: {
		Label: Pre-Hardmode Max Level
		Tooltip: Maximum world level during Pre-Hardmode phase. Enemies won't exceed this level. Default: 50
	}

	HardmodeMaxLevel: {
		Label: Hardmode Max Level
		Tooltip: Maximum world level during Hardmode phase (added to Pre-Hardmode cap). Cannot be lower than Pre-Hardmode cap. Default: 100
	}

	PostMoonLordMaxLevel: {
		Label: Post-Moon Lord Max Level
		Tooltip: Maximum world level after Moon Lord (added to previous caps). Post-Moon Lord bosses are those with life > Moon Lord. Default: 150
	}

	LevelVariance: {
		Label: Level Variance
		Tooltip: Random variation in enemy levels. Enemies spawn at WorldLevel ± Variance. Range: 0-10. Default: 2
	}

	LeveledEnemyXPBonusPerLevel: {
		Label: Leveled Enemy Exp Bonus Per Level (in %)
		Tooltip: Exp bonus percentage per enemy level. Formula: (1 + Level × This %) total Exp. Range: 1-10%. Default: 5% (level 10 enemy = +50% Exp)
	}

	Config: {
