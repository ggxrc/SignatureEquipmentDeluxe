	ProgressionConfig: {
		// GlobalMultipliersHeader: Global Exp Multiplier
		// CategoryMultipliersHeader: Weapon Exp Multiplier
		// WeaponXPSourcesHeader: Weapon Base Exp Per Hit
		// ArmorXPSourcesHeader: Armor Exp Per Damage Received
		// SpecialConditionsHeader: Allow Statue Exp
		// LevelCostCurveHeader: Start Price
		// KillStreakHeader: Enable Kill Streak System
		DisplayName: Configurações de Progressão

		GlobalExpMultiplier: {
			Label: Multiplicador Global de Exp
			Tooltip: Multiplica TODOS os ganhos de Exp. Padrão: 1.0
		}

		GlobalExpMultiplierExtra: {
			Label: Multiplicador Extra Global de Exp
			Tooltip: Bônus multiplicativo adicional de Exp. Soma com o GlobalExpMultiplier. Faixa: 1-100. Padrão: 1 (sem bônus extra)
		}

		WeaponExpMultiplier: {
			Label: Multiplicador de Exp de Armas
			Tooltip: Multiplica a Exp ganha por armas. Padrão: 1.0
		}

		ArmorExpMultiplier: {
			Label: Multiplicador de Exp de Armaduras
			Tooltip: Multiplica a Exp ganha por peças de armadura. Padrão: 1.0
		}

		WeaponBaseXPPerHit: {
			Label: Exp Base por Acerto
			Tooltip: Exp base concedida ao acertar um inimigo com uma arma. Padrão: 5
		}

		WeaponBaseXPPerKill: {
			Label: Exp Base por Abate
			Tooltip: Exp base concedida ao matar um inimigo com uma arma. Padrão: 50
		}

		WeaponXPPerDamageDealt: {
			Label: Exp por Dano Causado
			Tooltip: Multiplicador de Exp baseado no dano causado. Fórmula: Dano × Este Valor. Faixa: 1-10. Padrão: 1
		}

		WeaponXPPerEnemyMaxHP: {
			Label: Exp por Vida Máxima do Inimigo
			Tooltip: Multiplicador de Exp baseado na vida máxima do inimigo. Recompensa matar inimigos mais fortes. Faixa: 1-10. Padrão: 1
		}

		ArmorXPPerDamageReceived: {
			Label: Exp por Dano Recebido
			Tooltip: Exp ganha por ponto de dano recebido. Padrão: 1.0
		}

		ArmorXPIgnoreDefense: {
			Label: Ignorar Defesa para Exp
			Tooltip: Se ativado, armaduras ganham Exp do dano ANTES da redução por defesa. Padrão: false
		}

		ArmorXPPerDamageBlocked: {
			Label: Exp por Dano Bloqueado
			Tooltip: Exp ganha por ponto de dano bloqueado pela defesa. Padrão: 0.5
		}

		ArmorXPPerDodge: {
			Label: Exp por Esquiva
			Tooltip:
				'''
				EXPERIMENTAL: Esta opção não foi testada e não deve ser usada. 
				Não sei quais são os efeitos dela e será usada apenas no futuro para compatibilidade com o Terraria Overhaul.
				'''
		}

		AllowStatueXP: {
			Label: Permitir Exp de Estátuas
			Tooltip: Se ativado, inimigos spawnados por estátuas podem conceder Exp. Padrão: false (anti-farm)
		}

		StartPrice: {
			Label: Custo Inicial de Exp
			Tooltip: Exp necessária para o nível 1→2. Base da curva de progressão. Padrão: 100
		}

		AditionalPrice: {
			Label: Custo Adicional de Exp
			Tooltip: Valor fixo adicionado ao custo de Exp por nível. Fórmula: StartPrice + (Nível × Este). Padrão: 0
		}

		MultiPrice: {
			Label: Multiplicador de Custo de Exp
			Tooltip: Multiplica o custo total de Exp por nível. Quanto maior, mais difícil evoluir. Padrão: 1.0
		}

		EnableKillStreakSystem: {
			Label: Ativar Sistema de Sequência de Abates
			Tooltip: Ativa o sistema de streaks de abate. Requer recarregar o mod. Padrão: true
		}

		EnableStreakXPBonus: {
			Label: Ativar Bônus de Exp por Sequência
			Tooltip: Se ativado, sequências de abate concedem bônus de Exp. Padrão: true
		}

		StreakXPBonusPerKill: {
			Label: Bônus de Exp por Abate em Sequência (%)
			Tooltip: Porcentagem de bônus de Exp por abate consecutivo. Acumula até o máximo. Padrão: 1%
		}

		StreakXPBonusMax: {
			Label: Bônus Máximo de Exp por Sequência (%)
			Tooltip: Porcentagem máxima total de bônus de Exp por streak. Sem limite superior. Padrão: 50%
		}
	}

	WorldConfig: {
		// LeveledEnemyHeader: Enable Leveled Enemies
		// WorldProgressionHeader: World Level Mode
		// LevelCapsHeader: Pre Hardmode Max Level
		// SpawnVarianceHeader: Level Variance
		// EnemyRewardsHeader: Leveled Enemy Exp Bonus Per Level
		DisplayName: Configuração de Mundo

		EnableLeveledEnemies: {
			Label: Ativar Inimigos Nivelados
			Tooltip: Ativa o sistema de inimigos nivelados. Inimigos podem aparecer com níveis baseados na progressão do mundo. Requer recarregar o mod. Padrão: true
		}

		LeveledEnemySpawnChance: {
			Label: Chance de Inimigo Nivelado (%)
			Tooltip: Chance percentual de inimigos aparecerem com nível. Padrão: 15%
		}

		WorldLevelMode: {
			Label: Modo de Nível de Mundo
			Tooltip:
				'''
				Como o nível do mundo progride.
				Progressão por Chefes: Aumenta ao derrotar chefes.
				Progressão por Tempo: Aumenta 1 por dia.
				Desativado: Sem nível de mundo. Padrão: Progressão por Chefes
				'''
		}

		PreHardmodeMaxLevel: {
			Label: Nível Máximo Pré-Hardmode
			Tooltip: Nível máximo do mundo durante a fase Pré-Hardmode. Inimigos não ultrapassam esse nível. Padrão: 50
		}

		HardmodeMaxLevel: {
			Label: Nível Máximo Hardmode
			Tooltip: Nível máximo do mundo durante o Hardmode (adicionado ao cap Pré-Hardmode). Não pode ser menor que o cap Pré-Hardmode. Padrão: 100
		}

		PostMoonLordMaxLevel: {
			Label: Nível Máximo Pós-Moon Lord
			Tooltip: Nível máximo do mundo após Moon Lord (adicionado aos caps anteriores). Chefes pós-Moon Lord são aqueles com vida maior que o Moon Lord. Padrão: 150
		}

		LevelVariance: {
			Label: Variação de Nível
			Tooltip: Variação aleatória nos níveis dos inimigos. Inimigos aparecem com NívelMundo ± Variação. Faixa: 0-10. Padrão: 2
		}

		LeveledEnemyXPBonusPerLevel: {
			Label: Bônus de Exp por Nível do Inimigo (%)
			Tooltip: Bônus de Exp por nível do inimigo. Fórmula: (1 + Nível × Este %) Exp total. Faixa: 1-10%. Padrão: 5% (inimigo nível 10 = +50% Exp)
		}
	}

