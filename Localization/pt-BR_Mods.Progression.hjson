			Tooltip: Intervalo entre notificações visuais de sequência
		}

		ShowStreakEndNotification: {
			Label: Mostrar Notificação de Fim de Sequência
			Tooltip: Exibe mensagem quando uma sequência termina
		}

		EnableKillStreakSounds: {
			Label: Habilitar Sons de Sequência de Kills
			Tooltip: Toca sons especiais durante sequências de kills
