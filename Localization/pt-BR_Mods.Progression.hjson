	ClientConfig: {
		// TooltipDisplayHeader: Show Item Level
		// OutlineHeader: Enable Outline
		// OutlineColorsHeader: Outline Color_ Level1_25
		// TooltipCustomHeader: Show Tooltip Separator
		// NotificationsHeader: Show Level Up Notification
		// PerformanceHeader: Enable Particle Effects
		// AuraEffectsHeader: Enable Aura Effects
		// AdvancedHeader: Show Debug Info
		DisplayName: Configurações Visuais

		ShowItemLevel: {
			Label: Mostrar Nível do Item
			Tooltip: Exibe o nível do item no tooltip
		}

		ShowItemExperience: {
			Label: Mostrar Exp do Item
			Tooltip: Exibe a Exp atual e necessária no tooltip
		}

		ShowItemStats: {
			Label: Mostrar Stats do Item
			Tooltip: Exibe os bônus de stats no tooltip
		}

		ShowDetailedStats: {
			Label: Mostrar Stats Detalhados
			Tooltip: Exibe informações detalhadas sobre cada stat
		}

		ShowStatChanges: {
			Label: Mostrar Mudanças de Stats
			Tooltip: Exibe quanto cada stat aumentou
		}

		ShowCappedStats: {
			Label: Mostrar Stats Limitados
			Tooltip: Indica quando um stat atingiu o limite máximo
		}

		EnableOutline: {
			Label: Habilitar Contorno
			Tooltip: Adiciona um contorno colorido aos itens baseado no nível
		}

		OutlineMode: {
			Label: Modo de Contorno
			Tooltip: Escolha o estilo do contorno dos itens
		}

		OutlineThickness: {
			Label: Espessura do Contorno
			Tooltip: Ajusta a espessura do contorno dos itens
		}

		OutlineOpacity: {
			Label: Opacidade do Contorno
			Tooltip: Ajusta a transparência do contorno dos itens
		}

		OutlineColor_Level1_25: {
			Label: Cor Nível 1-25
			Tooltip: Cor do contorno para itens de nível 1 a 25
		}

		OutlineColor_Level26_50: {
			Label: Cor Nível 26-50
			Tooltip: Cor do contorno para itens de nível 26 a 50
		}

		OutlineColor_Level51_75: {
			Label: Cor Nível 51-75
			Tooltip: Cor do contorno para itens de nível 51 a 75
		}

		OutlineColor_Level76_100: {
			Label: Cor Nível 76-100
			Tooltip: Cor do contorno para itens de nível 76 a 100
		}

		OutlineColor_Level101Plus: {
			Label: Cor Nível 101+
			Tooltip: Cor do contorno para itens de nível 101 ou superior
		}

		ShowTooltipSeparator: {
			Label: Mostrar Separador de Tooltip
			Tooltip: Adiciona uma linha separadora no tooltip
		}

		ShowNextLevelInfo: {
			Label: Mostrar Info do Próximo Nível
			Tooltip: Exibe quanto falta para o próximo nível
		}

		ShowProgressBar: {
			Label: Mostrar Barra de Progresso
			Tooltip: Exibe uma barra visual de progresso de Exp
		}

		TooltipLevelColor: {
			Label: Cor do Nível no Tooltip
			Tooltip: Cor usada para exibir o nível do item
		}

		TooltipExpColor: {
			Label: Cor da Exp no Tooltip
			Tooltip: Cor usada para exibir a Exp do item
		}

		TooltipStatColor: {
			Label: Cor dos Stats no Tooltip
			Tooltip: Cor usada para exibir os bônus de stats
		}

		ShowLevelUpNotification: {
			Label: Mostrar Notificação de Level Up
			Tooltip: Exibe uma mensagem quando um item sobe de nível
		}

		ShowExpGainNotification: {
			Label: Mostrar Notificação de Ganho de Exp
			Tooltip: Exibe mensagens quando itens ganham Exp
		}

		NotificationDuration: {
			Label: Duração da Notificação
			Tooltip: Tempo em segundos que notificações ficam na tela
		}

		NotificationScale: {
			Label: Escala da Notificação
			Tooltip: Tamanho das notificações na tela
		}

