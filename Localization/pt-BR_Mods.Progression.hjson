		}

		AuraLevel_Medium: {
			Label: Nível de Aura Média
			Tooltip: Nível mínimo para aura média
		}

		AuraLevel_Strong: {
			Label: Nível de Aura Forte
			Tooltip: Nível mínimo para aura forte
		}

		AuraLevel_Intense: {
			Label: Nível de Aura Intensa
			Tooltip: Nível mínimo para aura intensa
		}

		EnableProjectileHitEffects: {
			Label: Habilitar Efeitos de Acerto de Projétil
			Tooltip: Exibe efeitos visuais quando projéteis acertam inimigos
		}

		HitEffectsMinLevel: {
			Label: Nível Mínimo para Efeitos de Acerto
			Tooltip: Nível mínimo do item para mostrar efeitos de acerto
		}

		HitEffectsIntensity: {
			Label: Intensidade dos Efeitos de Acerto
