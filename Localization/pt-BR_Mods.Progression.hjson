			Tooltip: Exibe efeitos de partículas visuais
		}

		EnableGlowEffects: {
			Label: Habilitar Efeitos de Brilho
			Tooltip: Adiciona efeitos de brilho a itens de alto nível
		}

		MaxParticlesPerSecond: {
			Label: Máximo de Partículas por Segundo
			Tooltip: Limita a quantidade de partículas para melhor performance
		}

		ReducedAnimations: {
			Label: Animações Reduzidas
			Tooltip: Reduz a intensidade das animações para melhor performance
		}

		EnableAuraEffects: {
			Label: Habilitar Efeitos de Aura
			Tooltip: Exibe auras em torno de itens de alto nível
		}

		AuraStyle: {
			Label: Estilo de Aura
