WorldConfig: {
	// DisplayName: World Configuration

	EnableLeveledEnemies: {
		// Label: Enable Leveled Enemies
		// Tooltip: Activates the leveled enemy system. Enemies can spawn with levels based on world progression. Requires mod reload. Default: true
	}

	LeveledEnemySpawnChance: {
		// Label: Leveled Enemy Spawn Chance (in %)
		// Tooltip: Percentage chance for enemies to spawn with a level. Range: 1-100%. Default: 15%
	}

