	IndividualItemOverride: {
		// Tooltip: ""
		// TargetHeader: 🎯 Target Item
		// StatsHeader: 📊 Custom Stat Configuration

		TargetItem: {
			Label: Item Alvo
			Tooltip:
				'''
				Selecione o item que terá configuração personalizada de escalonamento.
				Esta substituição tem prioridade sobre as configurações globais.
				'''
		}

		CustomDamage: {
			Label: Dano Personalizado
			Tooltip:
				'''
				Configuração de escalonamento de dano para este item específico.
				Substitui completamente a configuração global de dano.
				'''
		}

		CustomCritChance: {
			Label: Chance de Crítico Personalizada
			Tooltip:
				'''
				Configuração de escalonamento de chance de crítico para este item específico.
				Substitui completamente a configuração global de crítico.
				'''
		}

		CustomUseTime: {
			Label: Use Time Personalizado
			Tooltip:
				'''
				Configuração de escalonamento de use time para este item específico.
				Use time menor = ataque mais rápido.
				Substitui completamente a configuração global.
				'''
		}

		CustomUseAnimation: {
			Label: Use Animation Personalizada
			Tooltip:
				'''
				Configuração de escalonamento de use animation para este item específico.
				Deve geralmente corresponder ao use time.
				Substitui completamente a configuração global.
				'''
		}

		CustomMeleeSize: {
			Label: Tamanho Melee Personalizado
			Tooltip:
				'''
				Configuração de escalonamento de tamanho melee para este item específico.
				Aumenta o tamanho de armas melee conforme sobem de nível.
				Substitui completamente a configuração global.
				'''
		}

		CustomManaCostReduction: {
			Label: Redução de Custo de Mana Personalizada
			Tooltip:
				'''
				Configuração de escalonamento de redução de custo de mana para este item específico.
				Reduz quanto mana é gasto por uso.
				Substitui completamente a configuração global.
				'''
		}

		CustomAmmoConsumptionReduction: {
			Label: Redução de Consumo de Munição Personalizada
			Tooltip:
				'''
				Configuração de escalonamento de redução de consumo de munição para este item específico.
				Reduz chance de consumir munição ao atacar.
				Substitui completamente a configuração global.
				'''
		}

		StatusIncreaseType: {
			Label: Tipo de Aumento de Status
			Tooltip: Escolha como os stats deste item aumentam: Bruto (fixo por nível) ou Porcentagem (baseado nos stats originais). Substitui a configuração global.
		}
	}

	StatusIncreaseType: {
		Tooltip: ""

		Raw: {
			Label: Status Bruto
			Tooltip: Os stats aumentam por valores fixos por nível (sistema original)
		}

		Percentage: {
			Label: Porcentagem do Status do Equipamento
			Tooltip:
				'''
				Os stats aumentam baseados em uma porcentagem dos stats ORIGINAIS do item.
				Exemplo: Se uma arma tem 50 de dano base e PercentagePerLevel = 15,
				cada nível adiciona +7,5 de dano (15% de 50).
				'''
		}
	}

	ScalingConfig: {
		// ImmunityHeader: Local Immunity Mode
		// ArmorStatsHeader: Armor Defense
		// ProjectileStatsHeader: Weapon Projectile Size
		// WeaponStatsHeader: Weapon Damage
		// StatusIncreaseTypeHeader: Status Increase Type Header

		StatusIncreaseType: {
			Label: Tipo de Aumento de Status
			Tooltip:
				'''
				Determina como os stats escalonam por nível:
				• Status Bruto: Valores fixos por nível (sistema clássico)
				• Porcentagem do Status do Equipamento: Escalona baseado em % dos stats originais do item

				Exemplo com modo Porcentagem:
				Arma com 50 de dano base + PercentagePerLevel 15 = +7,5 de dano por nível
				'''
		}

		DisplayName: Configurações de Escalonamento

		WeaponCapMode: {
			Label: Modo de Limite de Nível de Armas
			Tooltip:
				'''
				Determina como funcionam os limites de nível de armas:
				• Nível do Mundo: Armas não podem exceder o nível do mundo (baseado em progressão)
				• Independente: Armas têm seu próprio nível máximo separado
				• Ilimitado: Sem limites de nível (progressão infinita)
				'''
		}

		WeaponIndependentMaxLevel: {
			Label: Nível Máximo Independente de Armas
			Tooltip:
				'''
				Nível máximo para armas ao usar o modo de limite 'Independente'.
				Ignorado se estiver usando os modos Nível do Mundo ou Ilimitado.
				Padrão: 100
				'''
		}

		ArmorMaxLevel: {
			Label: Nível Máximo de Armaduras
			Tooltip:
				'''
				Nível máximo que peças de armadura podem alcançar.
				Defina como 0 para progressão ilimitada de armaduras.
				Padrão: 100
				'''
		}

		DamageIncrement: {
			Label: Habilitar Escalonamento de Dano
			Tooltip: Permite que armas ganhem bônus de dano conforme sobem de nível.
		}

		CritIncrement: {
			Label: Habilitar Escalonamento de Chance Crítica
			Tooltip: Permite que armas ganhem chance de acerto crítico conforme sobem de nível.
		}

		UseTimeIncrement: {
			Label: Habilitar Redução de Tempo de Uso
			Tooltip: Permite que armas ataquem mais rápido conforme sobem de nível (reduz tempo de uso).
		}

		UseAnimationIncrement: {
			Label: Habilitar Aumento de Velocidade de Animação
			Tooltip: Permite que animações de armas acelerem conforme sobem de nível (ataques mais suaves e rápidos).
		}

		IncreaseBaseDamage: {
			Label: Escalonar Dano Base
			Tooltip:
				'''
				Aplica escalonamento de dano ao stat de dano base da arma.
				Isto afeta o valor de dano inerente do item diretamente.
				'''
		}

		IncreaseFlatDamage: {
			Label: Escalonar Dano Fixo
			Tooltip:
				'''
				Adiciona bônus de dano fixo além do dano base.
				Útil para ajustar finamente a progressão de dano.
				'''
		}

		IncreaseMultDamage: {
			Label: Escalonar Dano Multiplicativo
			Tooltip:
				'''
				Aplica escalonamento de dano multiplicativo (baseado em porcentagem).
				Combina com outras fontes de dano para crescimento exponencial.
				'''
		}

		ProjectileSizeIncrement: {
			Label: Habilitar Escalonamento de Tamanho de Projéteis
			Tooltip: Permite que projéteis cresçam conforme as armas sobem de nível, aumentando a área de acerto.
		}

		ProjectileSpeedIncrement: {
			Label: Habilitar Escalonamento de Velocidade de Projéteis
			Tooltip: Permite que projéteis se movam mais rápido conforme as armas sobem de nível.
		}

		ProjectilePenetrationIncrement: {
			Label: Habilitar Escalonamento de Penetração
			Tooltip: Permite que projéteis atravessem mais inimigos conforme as armas sobem de nível.
		}

		ProjectileLifeTimeIncrement: {
			Label: Habilitar Escalonamento de Tempo de Vida de Projéteis
			Tooltip: Permite que projéteis durem mais tempo (viagem mais longe) conforme as armas sobem de nível.
		}

		AdditionalProjectileChanceIncrement: {
			Label: Habilitar Chance de Projétil Adicional
			Tooltip: Permite que armas disparem projéteis extras conforme sobem de nível (aumenta DPS).
		}

		MeleeWeaponSizeIncrement: {
			Label: Habilitar Escalonamento de Tamanho de Armas Corpo a Corpo
			Tooltip: Permite que armas corpo a corpo tenham maior alcance/área de acerto conforme sobem de nível.
		}

		NotUseAmmoChanceIncrement: {
			Label: Habilitar Conservação de Munição
			Tooltip: Permite que armas de longo alcance tenham chance de não consumir munição conforme sobem de nível.
		}

		ManaCostReductionIncrement: {
			Label: Habilitar Redução de Custo de Mana
			Tooltip: Permite que armas mágicas consumam menos mana conforme sobem de nível.
		}

		WeaponDamage: {
			Label: Escalonamento de Dano de Armas
			Tooltip:
				'''
				Configura quanto dano as armas ganham por nível.
				Suporta modos de escalonamento Fixo e Em Camadas com camadas personalizáveis.
				'''
		}

		WeaponCritChance: {
			Label: Escalonamento de Chance Crítica de Armas
			Tooltip:
				'''
				Configura quanto de chance crítica as armas ganham por nível.
				Acertos críticos causam dano dobrado (ou mais com outros mods).
				'''
		}

		WeaponUseTime: {
			Label: Redução de Tempo de Uso de Armas
			Tooltip:
				'''
				Configura quanto o tempo de uso diminui por nível.
				Menor tempo de uso = ataques mais rápidos = maior DPS.
				'''
		}

		WeaponUseAnimation: {
			Label: Velocidade de Animação de Armas
			Tooltip:
				'''
				Configura quanto o tempo de animação diminui por nível.
				Torna os ataques mais suaves e responsivos.
				'''
		}

		WeaponMeleeSize: {
			Label: Escalonamento de Tamanho de Armas Corpo a Corpo
			Tooltip:
				'''
				Configura quanto as armas corpo a corpo crescem por nível.
				Afeta tamanho do golpe, alcance e cobertura da área de acerto.
				'''
		}

		WeaponManaCostReduction: {
			Label: Escalonamento de Redução de Custo de Mana
			Tooltip:
				'''
				Configura a redução de custo de mana por nível para armas mágicas.
				Níveis mais altos = magias mais baratas = mais dano mágico sustentado.
				'''
		}

		WeaponAmmoConsumptionReduction: {
			Label: Escalonamento de Conservação de Munição
			Tooltip:
				'''
				Configura a chance de conservação de munição por nível para armas de longo alcance.
				Níveis mais altos = menos munição consumida = menores custos de manutenção.
				'''
		}

		WeaponProjectileSize: {
			Label: Escalonamento de Tamanho de Projéteis
			Tooltip:
				'''
				Configura quanto os projéteis crescem por nível de arma.
				Projéteis maiores = mais fácil acertar = DPS mais consistente.
				'''
		}

		WeaponProjectileSpeed: {
			Label: Escalonamento de Velocidade de Projéteis
			Tooltip:
				'''
				Configura o aumento de velocidade de projéteis por nível de arma.
				Projéteis mais rápidos = melhor rastreamento = maior precisão de acerto.
				'''
		}

		WeaponProjectileLifeTime: {
			Label: Escalonamento de Tempo de Vida de Projéteis
			Tooltip:
				'''
				Configura quanto tempo a mais os projéteis duram por nível de arma.
				Maior duração = maior alcance = melhor para combate à distância.
				'''
		}

		WeaponProjectilePenetration: {
			Label: Escalonamento de Penetração de Projéteis
			Tooltip:
				'''
				Configura quantos inimigos adicionais os projéteis podem perfurar por nível.
				Maior penetração = melhor para controle de multidões e limpeza de mobs.
				'''
		}

		WeaponAdditionalProjectileChance: {
			Label: Chance de Projétil Adicional
			Tooltip:
				'''
				Configura a chance de disparar projéteis extras por nível de arma.
				Múltiplos projéteis = aumento massivo de DPS para todos os tipos de armas.
				'''
		}

		ArmorDefense: {
			Label: Escalonamento de Defesa de Armaduras
			Tooltip:
				'''
				Configura quanta defesa as armaduras ganham por nível.
				Maior defesa = dano recebido reduzido = melhor capacidade de sobrevivência.
				'''
		}

		LocalImmunityMode: {
			Label: Modo de Imunidade Local
			Tooltip:
				'''
				Controla como funcionam os quadros de imunidade local para projéteis:
				• Desabilitado: Usa o sistema de imunidade vanilla
				• UseLocal: Cada projétil tem imunidade separada
				• NoEffect: Projéteis compartilham imunidade mas não a acionam
				• HitOnce: Projétil só pode acertar uma vez por inimigo
				• Variantes de Cooldown: Define durações específicas de quadros de imunidade
				'''
		}

		ProjectileLocalFramesOverride: {
			Label: Substituições de Quadros de Imunidade de Projéteis
			Tooltip:
				'''
				Substitui os quadros de imunidade para tipos específicos de projéteis.
				Permite ajuste fino de com que frequência cada projétil pode acertar.
				Útil para balancear armas de disparo rápido vs. lentas.
				'''
		}

		ItemOverrides: {
			Label: Substituições de Itens Individuais
			Tooltip:
				'''
				Configure escalonamento personalizado para itens específicos.
				Cada substituição substitui completamente as configurações globais para aquele item.
				Útil para balancear armas específicas que precisam de progressão diferente.

				Exemplo de uso:
				1. Adicione uma nova substituição
				2. Selecione o item alvo
				3. Configure os stats personalizados
				4. A arma agora usa essas configurações ao invés das globais
				'''
		}
	}

	WeaponUseTime: {
		// Label: Weapon Use Time Reduction
		/* Tooltip:
			'''
			Configure how much use time decreases per level.
			Lower use time = faster attacks = higher DPS.
			''' */
	}

	WeaponUseAnimation: {
		// Label: Weapon Animation Speed
		/* Tooltip:
			'''
			Configure how much animation time decreases per level.
			Makes attacks smoother and more responsive.
			''' */
	}

	WeaponMeleeSize: {
		// Label: Melee Weapon Size Scaling
		/* Tooltip:
			'''
			Configure how much melee weapons grow per level.
			Affects swing size, reach, and hitbox coverage.
			''' */
	}

	WeaponManaCostReduction: {
		// Label: Mana Cost Reduction Scaling
		/* Tooltip:
			'''
			Configure mana cost reduction per level for magic weapons.
			Higher levels = cheaper spells = more sustained magic damage.
			''' */
	}

	WeaponAmmoConsumptionReduction: {
		// Label: Ammo Conservation Scaling
		/* Tooltip:
			'''
			Configure ammo conservation chance per level for ranged weapons.
			Higher levels = less ammo consumed = lower upkeep costs.
			''' */
	}

	// ===== PROJECTILE SCALING CONFIGURATION =====
	
	WeaponProjectileSize: {
		// Label: Projectile Size Scaling
		/* Tooltip:
			'''
			Configure how much projectiles grow per weapon level.
			Larger projectiles = easier to hit = more consistent DPS.
			''' */
	}

	WeaponProjectileSpeed: {
		// Label: Projectile Speed Scaling
		/* Tooltip:
			'''
			Configure projectile velocity increase per weapon level.
			Faster projectiles = better tracking = higher hit accuracy.
			''' */
	}

	WeaponProjectileLifeTime: {
		// Label: Projectile Lifetime Scaling
		/* Tooltip:
			'''
			Configure how much longer projectiles last per weapon level.
			Longer lifetime = greater range = better for long-distance combat.
			''' */
	}

	WeaponProjectilePenetration: {
		// Label: Projectile Penetration Scaling
		/* Tooltip:
			'''
			Configure how many additional enemies projectiles can pierce per level.
			Higher penetration = better for crowd control and mob clearing.
			''' */
	}

	WeaponAdditionalProjectileChance: {
		// Label: Additional Projectile Chance
		/* Tooltip:
			'''
			Configure chance to spawn extra projectiles per weapon level.
			Multiple projectiles = massive DPS increase for all weapon types.
			''' */
	}

	// ===== ARMOR SCALING CONFIGURATION =====
	
	ArmorDefense: {
		// Label: Armor Defense Scaling
		/* Tooltip:
			'''
			Configure how much defense armor gains per level.
			Higher defense = reduced damage taken = better survivability.
			''' */
	}

	// ===== IMMUNITY SETTINGS =====
	
	LocalImmunityMode: {
		// Label: Local Immunity Mode
		/* Tooltip:
			'''
			Controlsocal immunity frames work for projectiles:
			• Disabled: Use vanilla immunity system
			• UseLocal: Each projectile has separate immunity
			• NoEffect: Projectiles share immunity but don't trigger it
			• HitOnce: Projectile can only hit once per enemy
			• Cooldown variants: Set specific immunity frame durations
			''' */
	}

	ProjectileLocalFramesOverride: {
		// Label: Projectile Immunity Frame Overrides
		/* Tooltip:
			'''
			Override immunity frames for specific projectile types.
			Allows fine-tuning of how often each projectile can hit.
			Useful for balancing rapid-fire vs. slow weapons.
			''' */
	}

	// ===== INDIVIDUAL ITEM OVERRIDES =====
	
	ItemOverrides: {
		// Label: Individual Item Overrides
		/* Tooltip:
			'''
			Configure custom scaling for specific items.
			Each override completely replaces global settings for that item.
			Useful for balancing specific weapons or creating unique progression paths.

			Example: Make Terra Blade scale differently from other weapons.
			''' */
	}

	ItemStat: {
		// TieredSettingsHeader: Scaling Tiers
		// LegacySettingsHeader: Per Level
		// GlobalSettingsHeader: Max
		// FixedSettingsHeader: Per Level
	}
}

