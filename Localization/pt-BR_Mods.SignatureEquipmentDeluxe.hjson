			// Label: 🎯 Critical Chance Scaling
			// Tooltip: Configure how critical hit chance increases with level (max 100%)
		}

		Defense: {
			// Label: 🛡️ Defense Scaling
			// Tooltip: Configure how armor defense increases with level
		}

		UseSpeed: {
			// Label: ⚡ Use Speed Scaling
			// Tooltip: Configure how weapon use speed increases with level (max 100% = instant use)
		}

		MeleeSpeed: {
			// Label: ⚔️ Melee Speed Scaling
			// Tooltip: Configure melee swing speed increases with level
		}

		MeleeSize: {
			// Label: 📏 Melee Size Scaling
			// Tooltip: Configure how melee weapon hitbox size increases with level
		}

		ProjectileSize: {
			// Label: 📏 Projectile Size Scaling
			// Tooltip: Configure how projectile size scales with level
		}

		ProjectileSpeed: {
			// Label: 🚀 Projectile Speed Scaling
			// Tooltip: Configure how projectile velocity increases with level
		}

		ProjectileLifeTime: {
			// Label: ⏱️ Projectile Lifetime Scaling
			// Tooltip: Configure how long projectiles exist before despawning
		}

		ProjectilePenetration: {
			// Label: 💥 Projectile Penetration Scaling
			// Tooltip: Configure how many enemies projectiles can pierce through
		}

		ManaCostReduction: {
			// Label: 💙 Mana Cost Reduction
			// Tooltip: Configure mana cost reduction per level (max 99%)
		}

		AmmoConsumptionReduction: {
			// Label: 🏹 Ammo Conservation
			// Tooltip: Configure chance to not consume ammo per level (max 99%)
		}

		MinionSlotReduction: {
			// Label: 👻 Minion Slot Cost Reduction
			// Tooltip: Configure minion slot cost reduction per level for summoner weapons (max 99%)
		}

		GlobalItemBlacklist: {
			// Label: 🚫 Global Item Blacklist
			// Tooltip: Items in this list cannot gain levels or become signature equipment
		}

		NPCBlacklist: {
			// Label: 🚫 NPC Blacklist
			// Tooltip: NPCs in this list don't give XP when killed
		}

		SpecialProjectileMapping: {
			// Label: 🔗 Special Projectile Mapping
			// Tooltip: Links specific items to specific projectiles for stat calculation
		}

		LocalImmunityMode: {
			// Label: Projectile Immunity Mode
			// Tooltip: Controls how projectile immunity frames work (Disabled, UseLocal, various cooldown modes)
		}

		ProjectileLocalFramesOverride: {
			// Label: Projectile Immunity Overrides
			// Tooltip: Set custom immunity frames for specific projectiles
		}

		EnableMultiplayerSync: {
			// Label: Enable Multiplayer Sync
			// Tooltip: Synchronizes projectile stats in multiplayer (recommended: ON)
		}

		EnableProjectileStatCaching: {
			// Label: Enable Stat Caching
			// Tooltip: Caches projectile stat calculations for performance (recommended: ON)
		}

